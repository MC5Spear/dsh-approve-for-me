{
  "name": "dsh-approve-for-me",
  "version": "0.2.2+dsh.0.2.1-rc",
  "description": "Independent LLM review for DSH sandbox-escalation approvals.",
  "license": "MIT",
  "author": "MC5Spear (https://github.com/MC5Spear)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MC5Spear/dsh-approve-for-me.git"
  },
  "bugs": {
    "url": "https://github.com/MC5Spear/dsh-approve-for-me/issues"
  },
  "homepage": "https://github.com/MC5Spear/dsh-approve-for-me#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "docs",
    "client.js",
    "typert.host.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5"
  },
  "scripts": {
    "test": "node --import ./tools/_host-hooks.mjs --test \"test/*.test.mjs\"",
    "test:offline": "node --test \"test/*.test.mjs\"",
    "check": "node tools/check-syntax.mjs",
    "check:public-surface": "node tools/check-public-surface.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "check:docs:pack": "node tools/check-docs.mjs --pack",
    "probe:llm": "node tools/probe-llm-tools.mjs",
    "probe:reviewer": "node tools/probe-reviewer-live.mjs",
    "probe:budget": "node tools/probe-budget.mjs",
    "probe:rpc": "node tools/probe-rpc.mjs",
    "probe:typert": "node --import ./tools/_host-hooks.mjs tools/check-typert-manifest.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "approve-for-me",
    "auto-approve",
    "sandbox-escalation",
    "llm-reviewer"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5"
  }
}
